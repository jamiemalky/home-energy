    {
        "id": "33a29e1401f7846e",
        "type": "function",
        "z": "6ce2ee8629cac1e5",
        "name": "Pick readings",
        "func": "// The readings we want, and a short name for each\nconst wanted = {\n    'Ac/Grid/L1/Power': 'grid_power_w',\n    'Ac/Consumption/L1/Power': 'consumption_power_w',\n    'Dc/Pv/Power': 'pv_power_w',\n    'Dc/Battery/Power': 'battery_power_w',\n    'Dc/Battery/Soc': 'battery_soc_pct'\n};\n\n// Topic looks like N/<id>/system/0/Ac/Grid/L1/Power\n// Cut off the first four parts to get Ac/Grid/L1/Power\nconst path = msg.topic.split('/').slice(4).join('/');\nconst name = wanted[path];\n\n// Ignore anything we don't want, or with no number\nif (!name || typeof msg.payload.value !== 'number') {\n    return null;\n}\n\n// Pass on just the name and the value\nmsg.topic = name;\nmsg.payload = msg.payload.value;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 140,
        "wires": [
            [
                "c926ae9d0d19008d"
            ]
        ]
    },
    {
        "id": "c926ae9d0d19008d",
        "type": "function",
        "z": "6ce2ee8629cac1e5",
        "name": "Remember latest",
        "func": "// Store each reading with the time it arrived\nconst latest = flow.get('latest') || {};\nlatest[msg.topic] = { value: msg.payload, at: Date.now() };\nflow.set('latest', latest);\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
