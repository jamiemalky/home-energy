    {
        "id": "16f212b6c9e8bffd",
        "type": "function",
        "z": "6ce2ee8629cac1e5",
        "name": "Build insert",
        "func": "// Write every reading heard from in the last 10 minutes\nconst latest = flow.get('latest') || {};\nconst cutoff = Date.now() - 10 * 60 * 1000;\nconst names = Object.keys(latest).filter(n => latest[n].at >= cutoff);\nif (names.length === 0) return null;\n\nmsg.params = [names, names.map(n => latest[n].value)];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
